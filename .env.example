# OpsPilot application (copy to .env and provide secrets only locally)
OPSPILOT_ENVIRONMENT=development
OPSPILOT_DOCS_ENABLED=true

# DeepSeek compatibility probe
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Host-side CPU model benchmark
EMBEDDING_MODEL_PATH=D:\Agent\models\bge-m3
RERANKER_MODEL_PATH=D:\Agent\models\bge-reranker-large
MODEL_DEVICE=cpu
MODEL_INFERENCE_CONCURRENCY=1

# Future L0 storage and first target system. Values are intentionally blank.
DATABASE_URL=
SUPERSET_BASE_URL=
SUPERSET_MCP_URL=

# Evaluation/fallback switches. Their packages have no runtime implementation in OP-002.
SKILLS_ENABLED=false
SUPERSET_MCP_ENABLED=false
SPECIALISTS_ENABLED=false
