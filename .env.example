# DeepSeek compatibility probe (copy to .env and provide the key locally)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Host-side CPU model benchmark
EMBEDDING_MODEL_PATH=D:\Agent\models\bge-m3
RERANKER_MODEL_PATH=D:\Agent\models\bge-reranker-large
MODEL_DEVICE=cpu
MODEL_INFERENCE_CONCURRENCY=1
