# OpsPilot application (copy to .env and provide secrets only locally)
OPSPILOT_ENVIRONMENT=development
OPSPILOT_DOCS_ENABLED=true

# DeepSeek compatibility probe
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Host-side CPU model benchmark
EMBEDDING_MODEL_PATH=D:\Agent\models\bge-m3
RERANKER_MODEL_PATH=D:\Agent\models\bge-reranker-large
MODEL_DEVICE=cpu
MODEL_INFERENCE_CONCURRENCY=1

# L0 storage. These local defaults are non-sensitive and must be replaced outside development.
DATABASE_URL=postgresql+psycopg://opspilot:opspilot-local-only@127.0.0.1:55432/opspilot
OPSPILOT_POSTGRES_DB=opspilot
OPSPILOT_POSTGRES_USER=opspilot
OPSPILOT_POSTGRES_PASSWORD=opspilot-local-only
OPSPILOT_POSTGRES_PORT=55432

# API authentication. Generate a random 32+ byte secret locally; never commit the real value.
OPSPILOT_SECURITY_AUTH_TOKEN_SECRET=
OPSPILOT_SECURITY_AUTH_TOKEN_ISSUER=opspilot-local
OPSPILOT_SECURITY_AUTH_TOKEN_AUDIENCE=opspilot-api

# First target system. Provider credentials/tokens are injected at runtime and never stored here.
SUPERSET_BASE_URL=
SUPERSET_MCP_URL=

# Evaluation/fallback switches. MCP remains disabled unless an approved binding is enabled.
SKILLS_ENABLED=false
SUPERSET_MCP_ENABLED=false
SPECIALISTS_ENABLED=false
